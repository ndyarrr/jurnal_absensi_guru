APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jurnal_absensi_guru
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# WHATSAPP BOT (NODE.JS) & PM2 CONFIGURATION
# =============================================================================
WA_BOT_URL=http://127.0.0.1:3000
WA_BOT_PM2_APP_NAME=wa-bot

# -----------------------------------------------------------------------------
# 1. MODE AUTO / RELATIF (Rekomendasi - Otomatis untuk Windows & Linux)
#    Folder 'bot' relatif terhadap project Laravel. Binary PM2 & Node.js
#    akan dideteksi secara otomatis tanpa perlu hardcode path absolut!
# -----------------------------------------------------------------------------
WA_BOT_DIR=bot
# WA_BOT_PM2_BIN=
# WA_BOT_NODE_BIN=
# WA_BOT_PM2_HOME=

# -----------------------------------------------------------------------------
# 2. CONFIG LINUX (Tinggal uncomment jika ingin memakai path kustom di Linux)
#    - PM2 Lokal npm:  bot/node_modules/.bin/pm2
#    - PM2 Global npm: /usr/local/bin/pm2  atau  /usr/bin/pm2
# -----------------------------------------------------------------------------
# WA_BOT_DIR=bot
# Lokasi PM2 Lokal npm:  bot/node_modules/.bin/pm2
# WA_BOT_PM2_BIN=bot/node_modules/.bin/pm2
# WA_BOT_PM2_HOME=/home/www-data/.pm2
# WA_BOT_NODE_BIN=/usr/bin/node

# -----------------------------------------------------------------------------
# 3. CONFIG WINDOWS (Tinggal uncomment jika ingin memakai path kustom di Windows)
#    - PM2 Lokal npm:  bot\node_modules\.bin\pm2.cmd
#    - PM2 Global npm: %APPDATA%\npm\pm2.cmd
# -----------------------------------------------------------------------------
# WA_BOT_DIR=bot
# Lokasi PM2 Lokal npm:  bot\node_modules\.bin\pm2.cmd
# WA_BOT_PM2_BIN=bot\node_modules\.bin\pm2.cmd
# WA_BOT_PM2_HOME=C:\Users\<user>\.pm2
# WA_BOT_NODE_BIN=D:\nodejs\node.exe

